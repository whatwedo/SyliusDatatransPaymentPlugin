{
    "name": "whatwedo/sylius-datatrans-payment-plugin",
    "type": "sylius-plugin",
    "keywords": ["sylius", "sylius-plugin", "datatrans", "payment", "e-commerce"],
    "description": "Datatrans payment integration for your sylius e-commerce project.",
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "payum/core": "^1.7",
        "sylius/sylius": ">=1.11",
        "symfony/http-client": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/validator": "^5.4 || ^6.0 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.12 || ^2.0",
        "phpstan/phpstan-doctrine": "^1.3 || ^2.0",
        "phpstan/phpstan-webmozart-assert": "^1.1 || ^2.0",
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0",
        "sylius-labs/coding-standard": "^4.1.1",
        "whatwedo/php-coding-standard": "^1.2",
        "winzou/state-machine": "^0.4.6"
    },
    "autoload": {
        "psr-4": {
            "Whatwedo\\SyliusDatatransPaymentPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Whatwedo\\SyliusDatatransPaymentPlugin\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.1-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "ocramius/package-versions": true,
            "symfony/thanks": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
