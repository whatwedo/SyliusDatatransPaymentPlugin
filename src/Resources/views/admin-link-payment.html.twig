{% set wwd_pay_link = url('whatwedo_sylius_pay_from_link', {'payment': payment.id, 'token': payment.order.tokenValue}) %}
<div class="ui segment">
    <small style="line-height: 20px">{{ wwd_pay_link }}</small>
    <button type="button" id="wwd-copy-admin-link" class="ui icon labeled tiny green fluid button" data-link="{{ wwd_pay_link }}" onclick="
        const link = this.dataset.link;
        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(link);
            return;
        }
        const el = document.createElement('textarea');
        el.value = link;
        el.setAttribute('readonly', '');
        el.style.position = 'absolute';
        el.style.left = '-9999px';
        document.body.appendChild(el);
        el.select();
        document.execCommand('copy');
        document.body.removeChild(el);
    "><i class="copy icon"></i> {{ 'sylius.ui.copy'|trans }}</button>
</div>
